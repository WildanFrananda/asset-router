@if (Bars.Count == 0) {
    <p class="empty-state">Belum cukup data untuk menampilkan tren.</p>
}
else {
    <div class="trend-wrapper">
        <svg viewBox="0 0 320 180" class="trend" role="img" aria-label="Tren alokasi historis">
            @foreach (var bar in Bars) {
                <g>
                    @foreach (var seg in bar.Segments) {
                        <rect x="@Num(bar.X)" y="@Num(seg.Y)"
                                width="@Num(BarWidth)" height="@Num(seg.Height)"
                                fill="@seg.Color">
                            <title>@seg.Category: Rp @seg.Amount.ToString("N0")</title>
                        </rect>
                    }
                </g>
                <svg:text x="@Num(bar.X + BarWidth / 2)" y="172" text-anchor="middle" class="trend-label">
                    @bar.Label
                </svg:text>

            }
            <line x1="0" y1="160" x2="320" y2="160" class="trend-axis" />
        </svg>

        <ul class="trend-legend">
            @foreach (var entry in LegendEntries) {
                <li>
                    <span class="dot" style="background:@entry.Color"></span>
                    <span>@entry.Category</span>
                </li>
            }
        </ul>
    </div>
}

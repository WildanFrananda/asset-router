@page "/card-generator"                                                                                                                                                                                 
                                                                                                                                                                                                            
<div class="card-gen-page">                                                                                                                                                                             
    <!-- Header Title Section -->                                                                                                                                                                       
    <header class="card-gen-header">                                                                                                                                                                    
        <div>                                                                                                                                                                                           
            <h1 class="page-title">                                                                                                                                                                     
                <span class="icon-glow">🎨</span> Proof of Discipline Social Card                                                                                                                       
            </h1>                                                                                                                                                                                       
            <p class="page-subtitle">                                                                                                                                                                   
                Generate shareable, aesthetic infographic cards of your payday allocation strategy (Privacy-first: No raw numbers displayed).                                                           
            </p>                                                                                                                                                                                        
        </div>                                                                                                                                                                                          
                                                                                                                                                                                                        
        <div class="header-actions">                                                                                                                                                                    
            <button class="btn-copy-summary" @onclick="CopySummaryToClipboard">                                                                                                                         
                <span>📋 Copy Text Summary</span>                                                                                                                                                       
            </button>                                                                                                                                                                                   
        </div>                                                                                                                                                                                          
    </header>                                                                                                                                                                                           
                                                                                                                                                                                                        
    <div class="card-gen-layout">                                                                                                                                                                       
        <!-- Left: Customization Controls Panel -->                                                                                                                                                     
        <div class="controls-card">                                                                                                                                                                     
            <h3 class="panel-title">⚙️ Card Customization</h3>                                                                                                                                          
                                                                                                                                                                                                        
            <div class="control-group">                                                                                                                                                                 
                <label class="control-label">Card Theme</label>                                                                                                                                         
                <div class="theme-picker">                                                                                                                                                              
                    <button class="theme-btn theme-cyber @(SelectedTheme == "cyber" ? "active-theme" : "")"                                                                                             
                            @onclick='() => SelectTheme("cyber")'>                                                                                                                                      
                        Cyber Neon                                                                                                                                                                      
                    </button>                                                                                                                                                                           
                    <button class="theme-btn theme-gold @(SelectedTheme == "gold" ? "active-theme" : "")"                                                                                               
                            @onclick='() => SelectTheme("gold")'>                                                                                                                                       
                        Golden Empire                                                                                                                                                                   
                    </button>                                                                                                                                                                           
                    <button class="theme-btn theme-emerald @(SelectedTheme == "emerald" ? "active-theme" : "")"                                                                                         
                            @onclick='() => SelectTheme("emerald")'>                                                                                                                                    
                        Emerald Shield                                                                                                                                                                  
                    </button>                                                                                                                                                                           
                    <button class="theme-btn theme-obsidian @(SelectedTheme == "obsidian" ? "active-theme" : "")"                                                                                       
                            @onclick='() => SelectTheme("obsidian")'>                                                                                                                                   
                        Obsidian Dark                                                                                                                                                                   
                    </button>                                                                                                                                                                           
                </div>                                                                                                                                                                                  
            </div>                                                                                                                                                                                      
                                                                                                                                                                                                        
            <div class="control-group">                                                                                                                                                                 
                <label class="control-label">Display User Tag</label>                                                                                                                                   
                <input type="text" class="text-input" @bind="UserTag" placeholder="e.g. @@discipline_warrior" />                                                                                         
            </div>                                                                                                                                                                                      
                                                                                                                                                                                                        
            <div class="control-group">                                                                                                                                                                 
                <label class="control-label">Custom Tagline</label>                                                                                                                                     
                <input type="text" class="text-input" @bind="CustomTagline" placeholder="e.g. Allocate first, spend later!" />                                                                          
            </div>                                                                                                                                                                                      
        </div>                                                                                                                                                                                          
                                                                                                                                                                                                        
        <!-- Right: Live Aesthetic Card Preview -->                                                                                                                                                     
        <div class="preview-section">                                                                                                                                                                   
            <div class="social-card-preview theme-@SelectedTheme">                                                                                                                                      
                <!-- Card Branding Header -->                                                                                                                                                           
                <div class="card-brand-header">                                                                                                                                                         
                    <div class="brand-info">                                                                                                                                                            
                        <span class="brand-icon">🌌</span>                                                                                                                                              
                        <span class="brand-text">AssetRouter</span>                                                                                                                                     
                    </div>                                                                                                                                                                              
                    <span class="privacy-badge">PROVED DISCIPLINE</span>                                                                                                                                
                </div>                                                                                                                                                                                  
                                                                                                                                                                                                        
                <!-- User Tagline -->                                                                                                                                                                   
                <div class="user-profile-header">                                                                                                                                                       
                    <h3 class="user-handle">@UserTag</h3>                                                                                                                                               
                    <p class="user-tagline">"@CustomTagline"</p>                                                                                                                                        
                </div>                                                                                                                                                                                  
                                                                                                                                                                                                        
                <!-- Allocation Percentages Breakdown Grid (Dynamic Live State) -->                                                                                                                     
                <div class="card-breakdown-grid">                                                                                                                                                       
                    @foreach (var node in State.CurrentNodes) {                                                                                                                                         
                        <div class="breakdown-item">                                                                                                                                                    
                            <span class="item-name">@node.Name</span>                                                                                                                                   
                            <span class="item-bar"><span style="width: @(node.Percentage)%;"></span></span>
                            <span class="item-pct">@node.Percentage%</span>
                        </div>
                    }
                </div>

                <!-- Badges Footer (Dynamic Live State) -->                                                                                                                                             
                <div class="card-badges-footer">                                                                                                                                                        
                    <div class="badge-item">                                                                                                                                                            
                        <span class="badge-icon">🔥</span>                                                                                                                                              
                        <span>Payday Discipline Active</span>                                                                                                                                           
                    </div>                                                                                                                                                                              
                    <div class="badge-item">                                                                                                                                                            
                        <span class="badge-icon">🛡️</span>                                                                                                                                              
                        <span>@(State.ActiveStressTestResult?.SurvivalScore ?? 100)/100 Survival Score</span>                                                                                           
                    </div>                                                                                                                                                                              
                    <div class="badge-item">                                                                                                                                                            
                        <span class="badge-icon">🌊</span>                                                                                                                                              
                        <span>@(State.OverflowResult?.ActiveValves.Count ?? 0) Active Valves</span>                                                                                                     
                    </div>                                                                                                                                                                              
                </div>                                                                                                                                                                                  
                                                                                                                                                                                                        
                <div class="card-watermark">                                                                                                                                                            
                    assetrouter.app • Payday Asset Router                                                                                                                                               
                </div>                                                                                                                                                                                  
            </div>                                                                                                                                                                                      
                                                                                                                                                                                                        
            @if (_copiedToast) {
                <div class="toast-notification">                                                                                                                                                        
                    ✓ Summary text copied to clipboard! Ready to share.                                                                                                                                 
                </div>                                                                                                                                                                                  
            }                                                                                                                                                                                           
        </div>                                                                                                                                                                                          
    </div>                                                                                                                                                                                              
</div>
@inherits LayoutComponentBase                                                                                                                                                                           
                                                                                                                                                                                                            
<div class="app-layout">                                                                                                                                                                                
    <!-- Top Futuristic Glassmorphic Header -->                                                                                                                                                         
    <header class="app-topbar">                                                                                                                                                                         
        <div class="topbar-brand">                                                                                                                                                                      
            <span class="brand-logo">🌌</span>                                                                                                                                                          
            <span class="brand-name">AssetRouter</span>                                                                                                                                                 
            <span class="brand-badge">v2.0 Pro</span>                                                                                                                                                   
        </div>                                                                                                                                                                                          
                                                                                                                                                                                                        
        <nav class="topbar-nav">                                                                                                                                                                                
            <NavLink class="nav-item" href="" Match="NavLinkMatch.All">                                                                                                                                         
                <span class="nav-icon">📊</span> Command Center                                                                                                                                                 
            </NavLink>                                                                                                                                                                                          
            <NavLink class="nav-item" href="screener">                                                                                                                                                          
                <span class="nav-icon">🔍</span> Stock Screener                                                                                                                                                 
            </NavLink>                                                                                                                                                                                          
            <NavLink class="nav-item" href="analytics">                                                                                                                                                         
                <span class="nav-icon">📈</span> Analytics                                                                                                                                                      
            </NavLink>                                                                                                                                                                                          
            <NavLink class="nav-item" href="card-generator">                                                                                                                                                    
                <span class="nav-icon">🎨</span> Social Card                                                                                                                                                    
            </NavLink>                                                                                                                                                                                          
        </nav>
                                                                                                                                                                                                        
        <div class="topbar-status">                                                                                                                                                                     
            <span class="status-dot"></span>                                                                                                                                                            
            <span class="status-label">Offline-First WASM Engine</span>                                                                                                                                 
        </div>                                                                                                                                                                                          
    </header>                                                                                                                                                                                           
                                                                                                                                                                                                        
    <!-- Main Full-Bleed Content Area -->                                                                                                                                                               
    <main class="app-main-content">                                                                                                                                                                     
        @Body                                                                                                                                                                                           
    </main>                                                                                                                                                                                             
</div>